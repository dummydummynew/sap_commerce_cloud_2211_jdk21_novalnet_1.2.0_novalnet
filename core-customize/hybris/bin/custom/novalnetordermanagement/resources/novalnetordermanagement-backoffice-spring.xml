<beans xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns="http://www.springframework.org/schema/beans"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="novalnetordermanagementService"
          class="com.novalnet.novalnetordermanagement.services.NovalnetordermanagementService"/>

    <bean id="novalnetordermanagementLabelLocator" class="com.hybris.cockpitng.util.labels.ResourcesLabelLocator"
          scope="singleton" init-method="init" lazy-init="false">
        <property name="location" value="/novalnetordermanagement-backoffice-labels/"/>
        <property name="name" value="labels"/>
    </bean>

</beans>
