<beans xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns="http://www.springframework.org/schema/beans"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="novalnetbackofficeLabelLocator"
          class="com.hybris.cockpitng.util.labels.ResourcesLabelLocator"
          scope="singleton" init-method="init" lazy-init="false">
        <property name="location"
                  value="/novalnetbackoffice-backoffice-labels/"/>
        <property name="name" value="labels"/>
    </bean>

    <bean id="paymentAccessKeyEditor"
          class="com.novalnet.backoffice.editors.PaymentAccessKeyEditor">
        <property name="novalnetMerchantDetailsFacade"
                  ref="novalnetMerchantDetailsFacade"/>
        <property name="modelService" ref="modelService"/>
    </bean>

    <bean id="novalnetProductActivationKeyEditor"
          class="com.novalnet.backoffice.editors.ProductActivationKeyEditor">
        <property name="novalnetMerchantDetailsFacade"
                  ref="novalnetMerchantDetailsFacade"/>
        <property name="modelService" ref="modelService"/>
    </bean>

</beans>
