<?xml version="1.0" encoding="UTF-8"?>

<process xmlns="http://www.hybris.de/xsd/processdefinition"
         start="generateNovalnetOrderCompletedEmail"
         name="novalnetOrderCompletedEmailProcess"
         processClass="com.novalnet.model.NovalnetOrderCompletedEmailProcessModel"
         onError="error">

    <action id="generateNovalnetOrderCompletedEmail"
            bean="generateNovalnetOrderCompletedEmailAction">
        <transition name="OK" to="sendEmail"/>
        <transition name="NOK" to="error"/>
    </action>

    <action id="sendEmail" bean="sendEmail">
        <transition name="OK" to="removeSentEmail"/>
        <transition name="NOK" to="failed"/>
    </action>

    <action id="removeSentEmail" bean="removeSentEmail">
        <transition name="OK" to="success"/>
        <transition name="NOK" to="error"/>
    </action>

    <end id="error" state="ERROR">
        Something went wrong.
    </end>

    <end id="failed" state="FAILED">
        Could not send order completed email.
    </end>

    <end id="success" state="SUCCEEDED">
        Order completed email has been sent.
    </end>

</process>